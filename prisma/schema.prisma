// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A customer's embroidery design submitted from the storefront builder.
model Submission {
  id            String   @id @default(cuid())
  number        Int      @default(autoincrement())
  shop          String
  createdAt     DateTime @default(now())
  status        String   @default("new")
  customerName  String
  email         String
  phone         String?
  company       String?
  notes         String?
  productTitle  String?
  variantTitle  String?
  zoneLabel     String?
  quantity      Int
  estTotal      Float?
  spec          Json
  logoName      String
  logoType      String
  logoFileId    String?
  mockupFileId  String?
  draftOrderId  String?
  checkoutUrl   String?
  // Fallback copies when Shopify Files upload fails, so nothing a customer sends is lost.
  logoData      Bytes?
  mockupData    Bytes?
  // Design center
  stage         String    @default("new") // new, in_review, proof_sent, changes_requested, approved, in_production, done, cancelled
  attention     Boolean   @default(false) // customer wrote or responded and nobody has replied yet
  token         String?   @unique // secret for the customer's design page link
  updatedAt     DateTime  @default(now()) @updatedAt
  artworkFileId String? // clean flat-color version of the logo as shown in the builder
  artworkData   Bytes?
  proofFileId   String?
  proofData     Bytes?
  proofType     String?
  proofName     String?
  proofSentAt   DateTime?
  approvedAt    DateTime?
  messages      Message[]

  @@index([shop, createdAt])
  @@index([shop, stage])
  @@unique([number])
}

// Timeline of a design: messages with the customer, internal notes and status events.
model Message {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  kind         String     @default("message") // message (customer can see), note (internal), event
  author       String // staff, customer, system
  authorName   String?
  body         String

  @@index([submissionId, createdAt])
}
