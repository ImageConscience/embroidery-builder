{%- comment -%}
  Imprint Customizer builder markup, shared by the app block (themes with app blocks) and the
  "Imprint Customizer switch" app embed (auto-placement for themes without app blocks).
  Params: root_id, root_attrs, s (block settings: button label and styling), accent_color, use_fallback_setting, zones_json,
  auto_place (true when placed by the embed), place_selector, place_position (before|after).
  The product's location templates (imprint.location_templates) and mockup photo (imprint.mockup_photo,
  product or variant) decide whether it shows; the JSON setting is only a fallback for products without templates.
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign main_image = first_variant.featured_image | default: product.featured_image
  assign tpls = product.metafields.imprint.location_templates.value
  assign has_tpl = false
  if tpls != blank and tpls.size > 0
    assign has_tpl = true
  endif
  assign product_photo = product.metafields.imprint.mockup_photo.value
  assign has_photo = false
  if product_photo != blank
    assign has_photo = true
  else
    for v in product.variants
      if v.metafields.imprint.mockup_photo.value != blank
        assign has_photo = true
        break
      endif
    endfor
  endif
  assign use_fallback = false
  if has_tpl == false and use_fallback_setting and zones_json != blank
    assign use_fallback = true
  endif
  assign show_builder = false
  if product
    if has_tpl and has_photo
      assign show_builder = true
    elsif use_fallback and main_image
      assign show_builder = true
    endif
  endif
-%}
{%- if show_builder -%}
  {%- if request.design_mode -%}
    <p class="emb-embed-off" style="padding:8px 12px;border:1px dashed #b44a31;border-radius:8px;font-size:13px">
      Imprint Customizer is switched off for this theme, so customers don't see it. Turn on
      "Imprint Customizer switch" in Theme settings &gt; App embeds.
    </p>
  {%- endif -%}
  <div class="emb-root" data-emb-root id="emb-{{ root_id }}"{% if auto_place %} data-emb-auto="{{ place_selector | escape }}" data-emb-auto-pos="{{ place_position | default: 'before' }}"{% endif %} {{ root_attrs }}>
    {%- liquid
      assign b_bg = s.accent_color | default: accent_color | default: '#B44A31'
      assign b_fg = s.text_color | default: '#FFFFFF'
      assign b_style = s.button_style | default: 'filled'
      assign b_bw = s.border_width | default: 0
      assign b_bc = s.border_color | default: b_bg
      assign b_radius = s.border_radius | default: 8
      assign b_fs = s.font_size | default: 16
      assign b_pad = s.padding | default: 12
      assign b_case = s.text_case | default: 'none'
      assign b_full = true
      if s.full_width == false
        assign b_full = false
      endif
      if b_style == 'outline'
        assign b_fill = 'transparent'
        assign b_fg = b_bg
        if b_bw == 0
          assign b_bw = 2
        endif
      else
        assign b_fill = b_bg
      endif
    -%}
    {%- if s.font_source == 'custom' and s.button_font -%}
      <style>{{ s.button_font | font_face: font_display: 'swap' }}</style>
    {%- endif -%}
    <button type="button" class="emb-open{% unless b_full %} emb-open--fit{% endunless %}" data-emb-open
      style="--emb-accent: {{ b_bg }}; --emb-btn-bg: {{ b_fill }}; --emb-btn-fg: {{ b_fg }}; --emb-btn-bw: {{ b_bw }}px; --emb-btn-bc: {{ b_bc }}; --emb-btn-radius: {{ b_radius }}px; --emb-btn-fs: {{ b_fs }}px; --emb-btn-pad: {{ b_pad }}px; --emb-btn-case: {{ b_case }};{% if s.font_source == 'custom' and s.button_font %} --emb-btn-font: '{{ s.button_font.family }}', {{ s.button_font.fallback_families }}; --emb-btn-weight: {{ s.button_font.weight }};{% endif %}">
      {{ s.button_label | default: button_label | default: 'Customize with your logo' | escape }}
    </button>
    <script type="application/json" data-emb-config>
      {
        "proxyPath": "/apps/imprint",
        "shop": {{ shop.permanent_domain | json }},
        "product": {
          "id": {{ product.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "url": {{ product.url | json }}
        },
        "variants": [
          {%- for v in product.variants -%}
            {%- if has_tpl -%}
              {%- assign vimg = v.metafields.imprint.mockup_photo.value | default: product_photo -%}
              {%- if vimg == blank -%}
                {%- for v2 in product.variants -%}
                  {%- if v2.metafields.imprint.mockup_photo.value != blank -%}{%- assign vimg = v2.metafields.imprint.mockup_photo.value -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- assign vimg = v.featured_image | default: main_image -%}
            {%- endif -%}
            {
              "id": {{ v.id | json }},
              "title": {{ v.title | json }},
              "image": {{ vimg | image_url: width: 1400 | json }},
              "price": {{ v.price | json }},
              "available": {{ v.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "selectedVariantId": {{ first_variant.id | json }},
        "templates": [
          {%- if has_tpl -%}
            {%- for t in tpls -%}
              {
                "method": {{ t.method.value | json }},
                "name": {{ t.name.value | json }},
                "photoWidthIn": {{ t.photo_width_in.value | json }},
                "photoRatio": {{ t.photo_ratio.value | json }},
                "zones": {{ t.zones.value | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ],
        "zones": {%- if use_fallback -%}{{ zones_json }}{%- else -%}[]{%- endif -%},
        "currency": {{ cart.currency.iso_code | json }},
        "accent": {{ s.accent_color | default: accent_color | default: "#B44A31" | json }}
      }
    </script>
  </div>
{%- elsif request.design_mode and product -%}
  <p style="padding:8px 12px;border:1px dashed #b44a31;border-radius:8px;font-size:13px">
    {%- if has_tpl == false -%}
      Imprint Customizer: this product has no location template, so customers won't see the builder here.
      Assign one in the Imprint Customizer app under Location templates.
    {%- else -%}
      Imprint Customizer: this product has location templates but no mockup photo, so customers won't see the builder here.
      Add one in the app (Location templates, then the template's product list) or in the product's metafield "Imprint mockup photo".
    {%- endif -%}
  </p>
{%- endif -%}
