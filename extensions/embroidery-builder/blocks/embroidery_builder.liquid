{%- comment -%}
  Imprint Customizer app block. Add it to the product template in the theme editor.
  The product's location templates (product metafield imprint.location_templates, one per method, managed in the
  app under Location templates) decide which methods and locations are offered. They're drawn on the product's
  mockup photo (metafield imprint.mockup_photo, product or variant). Without a template and a photo, the builder
  doesn't show. The JSON setting is only a fallback for products without templates.
  Methods and pricing come from the app server (/apps/imprint/config) so checkout and the builder always match.
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign main_image = first_variant.featured_image | default: product.featured_image
  assign tpls = product.metafields.imprint.location_templates.value
  assign has_tpl = false
  if tpls != blank and tpls.size > 0
    assign has_tpl = true
  endif
  assign product_photo = product.metafields.imprint.mockup_photo.value
  assign has_photo = false
  if product_photo != blank
    assign has_photo = true
  else
    for v in product.variants
      if v.metafields.imprint.mockup_photo.value != blank
        assign has_photo = true
        break
      endif
    endfor
  endif
  assign use_fallback = false
  if has_tpl == false and block.settings.use_fallback and block.settings.zones_json != blank
    assign use_fallback = true
  endif
  assign show_builder = false
  if product
    if has_tpl and has_photo
      assign show_builder = true
    elsif use_fallback and main_image
      assign show_builder = true
    endif
  endif
-%}
{%- if show_builder -%}
  {%- if request.design_mode -%}
    <p class="emb-embed-off" style="padding:8px 12px;border:1px dashed #b44a31;border-radius:8px;font-size:13px">
      Imprint Customizer is switched off for this theme, so customers don't see it. Turn on
      "Imprint Customizer switch" in Theme settings &gt; App embeds.
    </p>
  {%- endif -%}
  <div class="emb-root" data-emb-root id="emb-{{ block.id }}" {{ block.shopify_attributes }}>
    <button type="button" class="emb-open" data-emb-open
      style="--emb-accent: {{ block.settings.accent_color }};">
      {{ block.settings.button_label | default: 'Customize with your logo' | escape }}
    </button>
    <script type="application/json" data-emb-config>
      {
        "proxyPath": "/apps/imprint",
        "shop": {{ shop.permanent_domain | json }},
        "product": {
          "id": {{ product.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "url": {{ product.url | json }}
        },
        "variants": [
          {%- for v in product.variants -%}
            {%- if has_tpl -%}
              {%- assign vimg = v.metafields.imprint.mockup_photo.value | default: product_photo -%}
              {%- if vimg == blank -%}
                {%- for v2 in product.variants -%}
                  {%- if v2.metafields.imprint.mockup_photo.value != blank -%}{%- assign vimg = v2.metafields.imprint.mockup_photo.value -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- assign vimg = v.featured_image | default: main_image -%}
            {%- endif -%}
            {
              "id": {{ v.id | json }},
              "title": {{ v.title | json }},
              "image": {{ vimg | image_url: width: 1400 | json }},
              "price": {{ v.price | json }},
              "available": {{ v.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "selectedVariantId": {{ first_variant.id | json }},
        "templates": [
          {%- if has_tpl -%}
            {%- for t in tpls -%}
              {
                "method": {{ t.method.value | json }},
                "name": {{ t.name.value | json }},
                "photoWidthIn": {{ t.photo_width_in.value | json }},
                "photoRatio": {{ t.photo_ratio.value | json }},
                "zones": {{ t.zones.value | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        ],
        "zones": {%- if use_fallback -%}{{ block.settings.zones_json }}{%- else -%}[]{%- endif -%},
        "currency": {{ cart.currency.iso_code | json }},
        "accent": {{ block.settings.accent_color | json }}
      }
    </script>
  </div>
{%- elsif request.design_mode and product -%}
  <p style="padding:8px 12px;border:1px dashed #b44a31;border-radius:8px;font-size:13px">
    {%- if has_tpl == false -%}
      Imprint Customizer: this product has no location template, so customers won't see the builder here.
      Assign one in the Imprint Customizer app under Location templates.
    {%- else -%}
      Imprint Customizer: this product has location templates but no mockup photo, so customers won't see the builder here.
      Add one in the app (Location templates, then the template's product list) or in the product's metafield "Imprint mockup photo".
    {%- endif -%}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Imprint Customizer",
  "target": "section",
  "javascript": "embroidery-builder.js",
  "stylesheet": "embroidery-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Customize with your logo"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B44A31"
    },
    {
      "type": "header",
      "content": "Products without location templates"
    },
    {
      "type": "checkbox",
      "id": "use_fallback",
      "label": "Show the builder using the locations below",
      "info": "Off: the builder only appears on products with location templates (set in the app under Location templates). Fallback locations are priced as standard embroidery.",
      "default": false
    },
    {
      "type": "textarea",
      "id": "zones_json",
      "label": "Fallback locations (JSON)",
      "info": "x, y, w, h are fractions of the product photo. widthIn is the real width of that box in inches. maxW and maxH are the largest logo allowed, in inches.",
      "default": "[{\"id\":\"chest\",\"label\":\"Chest\",\"x\":0.38,\"y\":0.16,\"w\":0.24,\"h\":0.2,\"widthIn\":5,\"maxW\":4,\"maxH\":4},{\"id\":\"left-pocket\",\"label\":\"Left pocket\",\"x\":0.22,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true},{\"id\":\"right-pocket\",\"label\":\"Right pocket\",\"x\":0.58,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true}]"
    }
  ]
}
{% endschema %}
