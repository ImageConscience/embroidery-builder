{%- comment -%}
  Embroidery builder app block. Add it to the product template in the theme editor.
  Locations come from the block setting for now (the admin zone editor replaces it later).
  Pricing comes from the app server (/apps/embroidery/config) so checkout and the builder always match.
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign main_image = first_variant.featured_image | default: product.featured_image
-%}
{%- if product and main_image -%}
  <div class="emb-root" data-emb-root id="emb-{{ block.id }}" {{ block.shopify_attributes }}>
    <button type="button" class="emb-open" data-emb-open
      style="--emb-accent: {{ block.settings.accent_color }};">
      {{ block.settings.button_label | default: 'Customize with your logo' | escape }}
    </button>
    <script type="application/json" data-emb-config>
      {
        "proxyPath": "/apps/embroidery",
        "shop": {{ shop.permanent_domain | json }},
        "product": {
          "id": {{ product.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "url": {{ product.url | json }}
        },
        "variants": [
          {%- for v in product.variants -%}
            {%- assign vimg = v.featured_image | default: main_image -%}
            {
              "id": {{ v.id | json }},
              "title": {{ v.title | json }},
              "image": {{ vimg | image_url: width: 1400 | json }},
              "price": {{ v.price | json }},
              "available": {{ v.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "selectedVariantId": {{ first_variant.id | json }},
        "zones": {{ block.settings.zones_json | default: '[]' }},
        "currency": {{ cart.currency.iso_code | json }},
        "accent": {{ block.settings.accent_color | json }}
      }
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Embroidery builder",
  "target": "section",
  "javascript": "embroidery-builder.js",
  "stylesheet": "embroidery-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Customize with your logo"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B44A31"
    },
    {
      "type": "textarea",
      "id": "zones_json",
      "label": "Embroidery locations (JSON)",
      "info": "x, y, w, h are fractions of the product photo. widthIn is the real width of that box in inches. maxW and maxH are the largest logo allowed, in inches.",
      "default": "[{\"id\":\"chest\",\"label\":\"Chest\",\"x\":0.38,\"y\":0.16,\"w\":0.24,\"h\":0.2,\"widthIn\":5,\"maxW\":4,\"maxH\":4},{\"id\":\"left-pocket\",\"label\":\"Left pocket\",\"x\":0.22,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true},{\"id\":\"right-pocket\",\"label\":\"Right pocket\",\"x\":0.58,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true}]"
    }
  ]
}
{% endschema %}
