{%- comment -%}
  Imprint Customizer app block. Add it to the product template in the theme editor (themes with app blocks).
  On themes without app blocks, turn on "Place automatically on product pages" in the
  "Imprint Customizer switch" app embed instead. The markup lives in snippets/imprint_builder.liquid.
{%- endcomment -%}
{%- render 'imprint_builder',
  root_id: block.id,
  root_attrs: block.shopify_attributes,
  s: block.settings,
  accent_color: block.settings.accent_color,
  use_fallback_setting: block.settings.use_fallback,
  zones_json: block.settings.zones_json,
  auto_place: false
-%}

{% schema %}
{
  "name": "Imprint Customizer",
  "target": "section",
  "javascript": "embroidery-builder.js",
  "stylesheet": "embroidery-builder.css",
  "settings": [
    {
      "type": "header",
      "content": "Customize button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Customize with your logo"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "filled"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "info": "Fill color (or text and outline color for the outline style). Also the accent color inside the customizer.",
      "default": "#B44A31"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "For the filled style.",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Outline width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Outline color",
      "default": "#B44A31"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Font",
      "options": [
        {
          "value": "theme",
          "label": "Same as the store"
        },
        {
          "value": "custom",
          "label": "Choose a font"
        }
      ],
      "default": "theme"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button font",
      "info": "Used when Font is set to Choose a font.",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Letter case",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "ALL CAPS"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Height (padding)",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Off: the button is only as wide as its label.",
      "default": true
    },
    {
      "type": "header",
      "content": "Products without location templates"
    },
    {
      "type": "checkbox",
      "id": "use_fallback",
      "label": "Show the builder using the locations below",
      "info": "Off: the builder only appears on products with location templates (set in the app under Location templates). Fallback locations are priced as standard embroidery.",
      "default": false
    },
    {
      "type": "textarea",
      "id": "zones_json",
      "label": "Fallback locations (JSON)",
      "info": "x, y, w, h are fractions of the product photo. widthIn is the real width of that box in inches. maxW and maxH are the largest logo allowed, in inches.",
      "default": "[{\"id\":\"chest\",\"label\":\"Chest\",\"x\":0.38,\"y\":0.16,\"w\":0.24,\"h\":0.2,\"widthIn\":5,\"maxW\":4,\"maxH\":4},{\"id\":\"left-pocket\",\"label\":\"Left pocket\",\"x\":0.22,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true},{\"id\":\"right-pocket\",\"label\":\"Right pocket\",\"x\":0.58,\"y\":0.62,\"w\":0.2,\"h\":0.14,\"widthIn\":5,\"maxW\":3.5,\"maxH\":2.5,\"daystarOnly\":true}]"
    }
  ]
}
{% endschema %}
