{%- comment -%}
  App embed: the master on/off switch for Imprint Customizer on this theme
  (Online Store > Themes > Customize > App embeds). When it's off, the builder button
  stays hidden on every product page of the theme, even where the block is placed.

  Themes without app blocks (older "vintage" themes) can't hold the Imprint Customizer block.
  For those, turn on "Place automatically on product pages": the embed adds the builder button
  right below the add-to-cart / buy-it-now buttons (or next to any element you name). If the block is also placed, the block wins.
{%- endcomment -%}
<style>.emb-root[data-emb-root]{display:block}.emb-embed-off{display:none!important}</style>
<script>window.EmbroideryBuilderOn = true;</script>
{%- if block.settings.auto_place and template.name == 'product' and product -%}
  {%- render 'imprint_builder',
    root_id: 'auto',
    root_attrs: '',
    s: block.settings,
    accent_color: block.settings.accent_color,
    use_fallback_setting: false,
    zones_json: '',
    auto_place: true,
    place_selector: block.settings.place_selector,
    place_position: block.settings.place_position
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Imprint Customizer switch",
  "target": "body",
  "javascript": "embroidery-builder.js",
  "stylesheet": "embroidery-builder.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_place",
      "label": "Place automatically on product pages",
      "info": "For themes that can't hold app blocks. Shows the builder button on products with a location template and mockup photo.",
      "default": false
    },
    {
      "type": "text",
      "id": "place_selector",
      "label": "Place it next to (CSS selector)",
      "info": "Leave empty to place it right below the add-to-cart and buy-it-now buttons. Or enter a CSS selector; the first match on the product page is used.",
      "placeholder": "Below the buy buttons"
    },
    {
      "type": "select",
      "id": "place_position",
      "label": "Position",
      "options": [
        {
          "value": "before",
          "label": "Before it"
        },
        {
          "value": "after",
          "label": "After it"
        }
      ],
      "default": "after"
    },
    {
      "type": "header",
      "content": "Customize button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Customize with your logo"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "filled"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "info": "Fill color (or text and outline color for the outline style). Also the accent color inside the customizer.",
      "default": "#B44A31"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "For the filled style.",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Outline width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Outline color",
      "default": "#B44A31"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Font",
      "options": [
        {
          "value": "theme",
          "label": "Same as the store"
        },
        {
          "value": "custom",
          "label": "Choose a font"
        }
      ],
      "default": "theme"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button font",
      "info": "Used when Font is set to Choose a font.",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Letter case",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "ALL CAPS"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Height (padding)",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Off: the button is only as wide as its label.",
      "default": true
    }
  ]
}
{% endschema %}
